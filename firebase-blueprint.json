{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Magnum Uniforms Database Schema",
  "description": "Schema definition for Magnum Uniforms cloud Firestore database",
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Authorized parent or master tailor profile in Magnum portal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["parent", "tailor", "guest"] },
        "avatarUrl": { "type": "string" },
        "defaultAddress": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    },
    "Order": {
      "title": "Uniform Order",
      "description": "Institutional school uniform order placed by parent",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order reference code, e.g., MU-2024-8921" },
        "userId": { "type": "string", "description": "Owner Firebase UID" },
        "userEmail": { "type": "string" },
        "studentName": { "type": "string" },
        "studentGrade": { "type": "string" },
        "school": { "type": "string" },
        "house": { "type": "string" },
        "date": { "type": "string" },
        "estimatedArrival": { "type": "string" },
        "total": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "contactNumber": { "type": "string" },
        "statusText": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["processing", "tailoring", "quality-check", "in-transit", "delivered"]
        },
        "timelineStep": { "type": "number" },
        "items": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "school", "items", "total", "status"]
    },
    "ChildProfile": {
      "title": "Student Profile",
      "description": "Registered student measurement and school association",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "school": { "type": "string" },
        "grade": { "type": "string" },
        "house": { "type": "string" },
        "rollNo": { "type": "string" },
        "height": { "type": "string" },
        "weight": { "type": "string" },
        "sizes": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "name", "school", "grade"]
    },
    "ExchangeRequest": {
      "title": "Uniform Exchange Request",
      "description": "7-day doorstep size exchange guarantee requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "itemName": { "type": "string" },
        "currentSize": { "type": "string" },
        "requestedSize": { "type": "string" },
        "reason": { "type": "string" },
        "pickupMode": { "type": "string" },
        "status": { "type": "string" },
        "requestDate": { "type": "string" }
      },
      "required": ["orderId", "userId", "itemName", "requestedSize"]
    },
    "Product": {
      "title": "Uniform Product SKU",
      "description": "Magnum institutional uniform SKU with real-time size inventory and school association",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "gender": { "type": "string", "enum": ["boys", "girls", "unisex"] },
        "ageGroup": { "type": "string" },
        "season": { "type": "string" },
        "price": { "type": "number" },
        "mrp": { "type": "number" },
        "discount": { "type": "number" },
        "images": { "type": "array" },
        "sizes": { "type": "array" },
        "status": { "type": "string", "enum": ["draft", "active", "out_of_stock", "discontinued", "archived"] },
        "isPublished": { "type": "boolean" },
        "totalStock": { "type": "number" },
        "fabricBlend": { "type": "string" },
        "badge": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "schoolId", "name", "sku", "category", "price", "status"]
    },
    "InventoryLog": {
      "title": "Stock Adjustment Audit Log",
      "description": "Traceable inventory adjustments and batch receipts for institutional uniforms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "size": { "type": "string" },
        "adjustment": { "type": "number" },
        "previousQuantity": { "type": "number" },
        "newQuantity": { "type": "number" },
        "reason": { "type": "string" },
        "user": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["productId", "size", "adjustment", "newQuantity", "reason"]
    }
  },
  "firestore": {
    "collections": {
      "users": {
        "schema": "User",
        "rules": "Users can read and update their own profile document. Tailors and admins can view profiles for order dispatch."
      },
      "orders": {
        "schema": "Order",
        "rules": "Authenticated parents can read and create their own orders. Tailor staff can read all orders and update fulfillment status."
      },
      "childProfiles": {
        "schema": "ChildProfile",
        "rules": "Parents can read, create and manage student profiles linked to their user ID."
      },
      "exchangeRequests": {
        "schema": "ExchangeRequest",
        "rules": "Parents can create exchange requests. Staff can review and update exchange status."
      },
      "products": {
        "schema": "Product",
        "rules": "Public read for active catalogue products. Master tailor and admin can create, edit, publish, and manage inventory."
      },
      "inventoryLogs": {
        "schema": "InventoryLog",
        "rules": "Master tailor and admin can record and inspect inventory audit trails."
      }
    }
  }
}
